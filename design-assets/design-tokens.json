{
  "$schema": "https://json.schemastore.org/design-token",
  "name": "ChanderGari Design Tokens",
  "description": "Design tokens for the ChanderGari travel planning application",
  "version": "1.0.0",
  "type": "json",

  "properties": {
    "color": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "object",
          "properties": {
            "blue": { "$value": "#004ac6", "description": "Primary brand color - sky blue" },
            "blueDark": { "$value": "{color.primary.blue}", "modify": [{ "type": "shade", "value": 15 }], "description": "Darker variant for hover states" },
            "blueLight": { "$value": "{color.primary.blue}", "modify": [{ "type": "tint", "value": 15 }], "description": "Lighter variant for backgrounds" }
          }
        },
        "accent": {
          "type": "object",
          "properties": {
            "orange": { "value": "#f97316", "description": "Accent color - sunset orange" },
            "orangeDark": { "$value": "{color.accent.orange}", "modify": [{ "type": "shade", "value": 15 }], "description": "Darker variant for hover states" },
            "orangeLight": { "$value": "{color.accent.orange}", "modify": [{ "type": "tint", "value": 15 }], "description": "Lighter variant for backgrounds" }
          }
        },
        "neutral": {
          "type": "object",
          "properties": {
            "white": { "value": "#ffffff", "description": "Pure white" },
            "black": { "value": "#000000", "description": "Pure black" },
            "gray50": { "value": "#f8fafc", "description": "Lightest gray" },
            "gray100": { "value": "#f1f5f9", "description": "Very light gray" },
            "gray200": { "value": "#e2e8f0", "description": "Light gray" },
            "gray300": { "value": "#cbd5e1", "description": "Light-medium gray" },
            "gray400": { "value": "#94a3b8", "description": "Medium gray" },
            "gray500": { "value": "#64748b", "description": "Medium dark gray" },
            "gray600": { "value": "#475569", "description": "Dark medium gray" },
            "gray700": { "value": "#334155", "description": "Dark gray" },
            "gray800": { "value": "#1e293b", "description": "Very dark gray" },
            "gray900": { "value": "#0f172a", "description": "Nearly black" }
          }
        },
        "semantic": {
          "type": "object",
          "properties": {
            "background": { "value": "{color.neutral.white}", "description": "Default background color" },
            "foreground": { "value": "{color.neutral.gray900}", "description": "Default foreground/text color" },
            "primary": { "value": "{color.primary.blue}", "description": "Primary interactive elements" },
            "primaryForeground": { "value": "{color.neutral.white}", "description": "Text on primary backgrounds" },
            "success": { "value": "#10b981", "description": "Success state color" },
            "warning": { "value": "#f59e0b", "description": "Warning state color" },
            "error": { "value": "#ef4444", "description": "Error state color" }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "object",
          "properties": {
            "sans": { "value": "\"Inter\", ui-sans-serif, system-ui, sans-serif", "description": "Primary sans-serif font" },
            "mono": { "value": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace", "description": "Monospace font for code" }
          }
        },
        "fontSize": {
          "type": "object",
          "properties": {
            "xs": { "value": "0.75rem", "description": "Extra small text" },
            "sm": { "value": "0.875rem", "description": "Small text" },
            "base": { "value": "1rem", "description": "Base text size" },
            "lg": { "value": "1.125rem", "description": "Large text" },
            "xl": { "value": "1.25rem", "description": "Extra large text" },
            "2xl": { "value": "1.5rem", "description": "2x large text" },
            "3xl": { "value": "1.875rem", "description": "3x large text" },
            "4xl": { "value": "2.25rem", "description": "4x large text" },
            "5xl": { "value": "3rem", "description": "5x large text" },
            "6xl": { "value": "3.75rem", "description": "6x large text" }
          }
        },
        "fontWeight": {
          "type": "object",
          "properties": {
            "light": { "value": "300", "description": "Light font weight" },
            "normal": { "value": "400", "description": "Normal font weight" },
            "medium": { "value": "500", "description": "Medium font weight" },
            "semibold": { "value": "600", "description": "Semi-bold font weight" },
            "bold": { "value": "700", "description": "Bold font weight" },
            "extrabold": { "value": "800", "description": "Extra-bold font weight" }
          }
        },
        "letterSpacing": {
          "type": "object",
          "properties": {
            "tighter": { "value": "-0.05em", "description": "Tighter letter spacing" },
            "tight": { "value": "-0.025em", "description": "Tight letter spacing" },
            "normal": { "value": "0", "description": "Normal letter spacing" },
            "wide": { "value": "0.025em", "description": "Wide letter spacing" },
            "wider": { "value": "0.05em", "description": "Wider letter spacing" },
            "widest": { "value": "0.1em", "description": "Widest letter spacing" }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "properties": {
        "px": { "value": "1px", "description": "1 pixel" },
        "0": { "value": "0", "description": "Zero spacing" },
        "1": { "value": "0.25rem", "description": "4 pixels" },
        "2": { "value": "0.5rem", "description": "8 pixels" },
        "3": { "value": "0.75rem", "description": "12 pixels" },
        "4": { "value": "1rem", "description": "16 pixels" },
        "5": { "value": "1.25rem", "description": "20 pixels" },
        "6": { "value": "1.5rem", "description": "24 pixels" },
        "8": { "value": "2rem", "description": "32 pixels" },
        "10": { "value": "2.5rem", "description": "40 pixels" },
        "12": { "value": "3rem", "description": "48 pixels" },
        "16": { "value": "4rem", "description": "64 pixels" },
        "20": { "value": "5rem", "description": "80 pixels" },
        "24": { "value": "6rem", "description": "96 pixels" },
        "32": { "value": "8rem", "description": "128 pixels" }
      }
    },
    "radius": {
      "type": "object",
      "properties": {
        "none": { "value": "0", "description": "No border radius" },
        "sm": { "value": "0.125rem", "description": "Small border radius (2px)" },
        "default": { "value": "0.25rem", "description": "Default border radius (4px)" },
        "md": { "value": "0.375rem", "description": "Medium border radius (6px)" },
        "lg": { "value": "0.5rem", "description": "Large border radius (8px)" },
        "xl": { "value": "0.75rem", "description": "Extra large border radius (12px)" },
        "2xl": { "value": "1rem", "description": "2x large border radius (16px)" },
        "3xl": { "value": "1.5rem", "description": "3x large border radius (24px)" },
        "full": { "value": "9999px", "description": "Full border radius (pill shape)" }
      }
    },
    "shadow": {
      "type": "object",
      "properties": {
        "none": { "value": "0 0 #0000", "description": "No shadow" },
        "sm": { "value": "0 1px 2px 0 rgba(0, 0, 0, 0.05)", "description": "Small shadow" },
        "default": { "value": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)", "description": "Default shadow" },
        "md": { "value": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)", "description": "Medium shadow" },
        "lg": { "value": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)", "description": "Large shadow" },
        "xl": { "value": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -3px rgba(0, 0, 0, 0.04)", "description": "Extra large shadow" },
        "2xl": { "value": "0 25px 50px -12px rgba(0, 0, 0, 0.25)", "description": "2x large shadow" },
        "inner": { "value": "inset 0 2px 4px 0 rgba(0, 0, 0, 0.06)", "description": "Inner shadow" }
      }
    },
    "zIndex": {
      "type": "object",
      "properties": {
        "auto": { "value": "auto", "description": "Auto z-index" },
        "0": { "value": "0", "description": "Base layer" },
        "10": { "value": "10", "description": "Low overlay" },
        "20": { "value": "20", "description": "Medium overlay" },
        "30": { "value": "30", "description": "High overlay" },
        "40": { "value": "40", "description": "Very high overlay" },
        "50": { "value": "50", "description": "Maximum overlay" },
        "100": { "value": "100", "description": "Modal/z-index layer" },
        "200": { "value": "200", "description": "Popup/z-index layer" },
        "300": { "value": "300", "description": "Toast/z-index layer" },
        "400": { "value": "400", "description": "Overlay/z-index layer" }
      }
    }
  }
}